<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <application android:theme="@style/AppTheme" android:label="MergeWindow" android:icon="@drawable/ic_launcher"
        android:allowBackup="false" android:supportsRtl="true">
        <!-- Pleos 2.1 provides android.car-module on the boot class path. -->
        <uses-library android:name="android.car" android:required="false" />
        <!-- Stationary development demo. No distractionOptimized declaration, navigation
             focus ownership, background guidance, voice guidance or route overlay. -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
